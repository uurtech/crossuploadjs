# Port the server listens on.
PORT=4000
# URL the phone uses to reach this server. Must be reachable from the phone
# (your LAN IP in development, your public HTTPS domain in production).
# Default: http://<first LAN IPv4>:PORT
PUBLIC_URL=
# Server-to-server secret your backend sends to POST /v1/sessions.
# Required in production. In development a random one is generated and printed.
SECRET_KEY=
# Comma-separated origins allowed to use the widget, or * (development only).
ALLOWED_ORIGINS=*
# Defaults for every session; your backend can narrow them per session.
ALLOWED_TYPES=image/jpeg,image/png,image/heic,image/webp,application/pdf
MAX_FILE_SIZE_MB=10
MAX_FILES=5
# Where files and the metadata store live.
DATA_DIR=./data
# Accepted files are deleted after this many hours.
FILE_TTL_HOURS=24
# Session (and its QR code) lifetime in minutes.
SESSION_TTL_MINUTES=30
# Serve the demo form at / (set to false in production).
DEMO=true
